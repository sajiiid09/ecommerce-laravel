# ---------------------------------------------------------------------------
# StoreZ production environment - grameenhalchal.com
#
# Copy this to /var/www/storez/.env on the VPS and fill in the four values
# marked CHANGE-ME. Do not commit the filled-in file.
#
#   docker compose -f docker-compose.prod.yml --env-file .env config
#
# Everything else is already correct for this deployment topology.
# ---------------------------------------------------------------------------

APP_NAME=StoreZ
APP_ENV=production
APP_DEBUG=false

# CHANGE-ME (1/4). Generate once, then keep it forever - changing it
# invalidates every existing session and encrypted value:
#   docker compose -f docker-compose.prod.yml run --rm --no-deps app \
#       php artisan key:generate --show
APP_KEY=

# Drives route generation, asset URLs and - importantly - the public URL of
# uploaded media (config/filesystems.php builds it from APP_URL).
# Must be the public HTTPS origin, not the container address.
APP_URL=https://grameenhalchal.com
ASSET_URL=https://grameenhalchal.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Admin bootstrap
#
# Read only by database/seeders/DatabaseSeeder.php, i.e. only when
# RUN_SEEDERS=true. Set these BEFORE the first seeded boot; changing them
# afterwards does not update the existing user.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@grameenhalchal.com
# CHANGE-ME (2/4)
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Database - the host's PostgreSQL, reached over the docker bridge.
#
# host.docker.internal resolves via the extra_hosts host-gateway mapping in
# docker-compose.prod.yml. This is a dedicated database and role; it cannot
# read the other databases on that instance.
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=host.docker.internal
DB_PORT=5432
DB_DATABASE=storez
DB_USERNAME=storez
# CHANGE-ME (3/4) - must match the password given to `createuser --pwprompt storez`
DB_PASSWORD=
# The bridge is a private network; the host does not serve TLS on 5432.
DB_SSLMODE=prefer

# ---------------------------------------------------------------------------
# Redis - this stack's own container (service name `redis`), not the
# racolearnhub one. No password: it publishes no port and is only reachable
# from inside this compose network.
# ---------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_PREFIX=storez_
REDIS_DB=0
REDIS_CACHE_DB=1

# CACHE_STORE must support atomic locks: the hourly content:sync-scheduled
# command uses ->onOneServer(). `file` would throw. The entrypoint enforces this.
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=sync

SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# The host nginx terminates TLS, so cookies must be HTTPS-only. This works
# because TrustProxies (bootstrap/app.php) reads X-Forwarded-Proto.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# ---------------------------------------------------------------------------
# Filesystem - local disks on Docker named volumes. Do NOT switch to s3:
# league/flysystem-aws-s3-v3 is not installed, and MediaService/ImageHandler
# hardcode the 'public' disk.
# ---------------------------------------------------------------------------
FILESYSTEM_DISK=local

# ---------------------------------------------------------------------------
# Logging - stderr so `docker logs` and the json-file driver capture it.
# ---------------------------------------------------------------------------
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_LEVEL=error
LOG_DEPRECATIONS_CHANNEL=null

# ---------------------------------------------------------------------------
# Mail - DISABLED.
#
# `log` writes mail to the application log instead of sending it. Order
# confirmations, password resets and any other outbound mail will NOT reach
# customers until real SMTP credentials are set here.
#
# To enable, set MAIL_MAILER=smtp and fill in host/port/username/password.
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@grameenhalchal.com"
MAIL_FROM_NAME="${APP_NAME}"

BROADCAST_CONNECTION=log

# ---------------------------------------------------------------------------
# Deployment flags, read by docker/prod/entrypoint.sh
# ---------------------------------------------------------------------------
# Applies pending migrations on every boot. Safe to leave true.
RUN_MIGRATIONS=true

# FIRST BOOT ONLY (4/4). Set to true for the very first `up`, then set it
# back to false. Seeds the demo catalog, copies ~90 product images onto the
# public volume, and creates the admin user above.
RUN_SEEDERS=false

# Host port the container binds to on 127.0.0.1. Verified free on this VPS.
APP_BIND_PORT=8092

# ---------------------------------------------------------------------------
# Feature flags (config/features.php)
# ---------------------------------------------------------------------------
FEATURE_REVIEWS=true
FEATURE_GUEST_CHECKOUT=true
FEATURE_CATALOG_IMPORT_EXPORT=false
FEATURE_MARKETING=false
FEATURE_ADVANCED_SEO=false
FEATURE_ADVANCED_INVENTORY_HISTORY=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# NOT set here on purpose:
#
#   STRIPE_*  - Stripe API keys and the webhook signing secret are stored in
#               the database and managed at /admin/settings/payments.
#               See app/Services/PaymentCredentialService.php.
#   AWS_*     - unused; see the FILESYSTEM_DISK note above.
# ---------------------------------------------------------------------------
