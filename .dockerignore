# VCS / tooling
.git
.gitattributes
.gitignore
.editorconfig
.agents
.codex
.claude

# Environment files - never bake secrets into the image.
# Production config is supplied at runtime via compose env_file.
.env
.env.*
env

# Dependencies - installed inside the build stages
node_modules
vendor

# Build output - regenerated by the assets stage
public/build
public/hot
public/storage

# Runtime state - these are Docker volumes in production
storage/app/public
storage/app/private
storage/logs
storage/framework/cache/data
storage/framework/sessions
storage/framework/views
storage/framework/testing-views
storage/pail
storage/*.key

# Dead code: root-level Livewire/ uses namespace Src\Components\Livewire\Concerns,
# which is not in composer.json's PSR-4 map and is referenced nowhere.
# The live traits are in app/Livewire/Concerns/.
Livewire

# Tests and dev-only config
tests
phpunit.xml
.phpunit.result.cache
.phpunit.cache
pint.json

# Docker / deploy files - not needed inside the image
Dockerfile
Dockerfile.*
docker-compose.yml
docker-compose.*.yml

# Docs and agent instructions
*.md
boost.json
opencode.json

# Editor / OS cruft
.idea
.vscode
.zed
.fleet
.nova
.DS_Store
Thumbs.db
auth.json
